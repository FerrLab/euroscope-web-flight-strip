# Local-only env overrides for `pnpm nx dev web` (host-side Next.js dev server).
# Copy to .env.local (gitignored) and adjust to your shell environment.

# EUROSTRIP_BACKEND_URL is the URL the Next.js route handlers use to reach the
# backend container's HTTP port. Default in code is http://127.0.0.1:8000, which
# works on Windows-native PowerShell / cmd / Git Bash and on macOS/Linux native
# shells. WSL2 needs `host.docker.internal` because WSL2's loopback is its own
# distro, not the Windows host where Docker Desktop binds ports.
#
# Pick the line that matches your dev shell:

# Windows-native (PowerShell, cmd) or macOS / Linux native — default works:
# EUROSTRIP_BACKEND_URL=http://127.0.0.1:8000

# WSL2:
EUROSTRIP_BACKEND_URL=http://host.docker.internal:8000

# (Browser-side var; client URL the frontend uses for any direct backend calls.
# In practice everything goes through the Next.js proxy at /api/proxy/*, so
# this rarely matters, but the convention is to set it for consistency.)
NEXT_PUBLIC_API_URL=http://localhost:8000
