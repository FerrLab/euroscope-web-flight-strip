includes:
  - vendor/larastan/larastan/extension.neon

parameters:
  paths:
    - app
    - database
    - phpstan-rules
    - tests

  level: 8

  excludePaths:
    - tests/Static/RawPermissionFixture.php

  ignoreErrors:
    # Pest 4 chained DSL — `$this` inside `it(...)` closures resolves to
    # Pest\PendingCalls\TestCall in PHPStan's eyes, but at runtime is the
    # bound TestCase (with MakesHttpRequests, InteractsWithDatabase, etc).
    # Larastan does not yet ship Pest-aware type inference; ignore these.
    - identifier: method.notFound
      message: '#Call to an undefined method Pest\\PendingCalls\\TestCall::#'
    - identifier: property.notFound
      message: '#(Access to|access)( an)? undefined property Pest\\PendingCalls\\TestCall::#'
    # Mockery's fluent `shouldReceive(...)->once()`-style expectation chains —
    # Larastan's Mockery stubs don't fully resolve the return type of chained
    # expectation-builder methods, so calls like ->once() on the result read
    # as undefined even though they work correctly at runtime.
    - identifier: method.notFound
      message: '#Call to an undefined method Mockery\\ExpectationInterface\|Mockery\\HigherOrderMessage::#'
    # Pest's `expect(...)->not->toX()` negation syntax — `Pest\Mixins\Expectation::$not`
    # is a real, working runtime property that Larastan's Pest stubs don't declare.
    - identifier: property.notFound
      message: '#(Access to|access)( an)? undefined property Pest\\Mixins\\Expectation<.*>::\$not#'
    # Laravel\Socialite\Two\User (and its AbstractUser parent) resolves
    # provider-specific attributes like `cid`/`full_name` dynamically via
    # __get() from the raw OAuth payload — they are never declared as real
    # class properties, so PHPStan can't see them even on the concrete class.
    - identifier: property.notFound
      message: '#Access to an undefined property Laravel\\Socialite\\Two\\User::\$(cid|full_name)\b#'

services:
  - class: App\Static\PreventRawPermissionStrings
    tags:
      - phpstan.rules.rule
