# Filament publishes vendor assets to public/ on every `composer install`,
# `filament:upgrade`, or any package's post-update-cmd hook that triggers it.
# These are deterministic outputs of vendor code, so they don't need to live
# in the repo — CI/deploy republishes them with `php artisan filament:assets`.
/public/css/filament/
/public/fonts/filament/
/public/js/filament/

# Passport encryption keys — generated per environment by passport:keys --force
# in the entrypoint. Never commit; AppServiceProvider chmods them at boot.
/storage/passport/
